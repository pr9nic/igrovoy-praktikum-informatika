static func mount_pos(m: String) -> Vector3:
	var P: Dictionary = LAY.POS
	var T: Dictionary = LAY.PTS
	var map := {"board": "board", "socket": "cpu", "cooler": "cooler", "dimm2": "ram0", "dimm4": "ram1", "pcie_x16": "gpu", "m2": "ssd", "bay": "hdd", "psu_bay": "psu"}
	if map.has(m):
		var a: Array = P[map[m]]
		return Vector3(a[0], a[1], a[2])
	var b: Array = T[m]
	return Vector3(b[0], b[1], b[2])

static func kind_of(part: String) -> String:
	return "ram" if part.begins_with("ram") else part

# Можно ли поставить деталь в гнездо (с учётом уже установленного). Возвращает "" или объяснение ошибки.
static func try_place(part: String, mount: String, have: Dictionary, grade: int) -> String:
	var k := kind_of(part)
	var want: String = MOUNT[mount][1]
	if part != "board" and not have.has("board") and mount != "psu_bay" and mount != "bay":
		return "Сначала материнская плата: на неё ставятся остальные детали."
	if want != k:
		match k:
			"cpu":
				return "Процессор ставится в квадратный сокет с рычагом, а это — %s." % MOUNT[mount][0].to_lower()
			"ram":
				return "Память ставится в длинные узкие слоты рядом с процессором, а это — %s." % MOUNT[mount][0].to_lower()
			"gpu":
				return "Видеокарте нужен самый длинный слот PCIe x16. Короткий x1 — для плат расширения попроще." if mount == "pcie_x1" else "Видеокарта ставится в длинный слот PCIe x16 под процессором."
			"ssd":
				return "SSD формата M.2 вкручивается в плоский слот M.2 прямо на плате."
			"hdd":
				return "Жёсткий диск 3,5\" ставится в корзину для дисков внизу спереди."
			"psu":
				return "Блок питания стоит внизу сзади, вентилятором вниз."
			"cooler":
				return "Кулер ставится прямо на процессор — снимает с него тепло."
		return "Сюда эта деталь не подходит."
	if k == "cooler" and not have.has("cpu"):
		return "Кулер ставится поверх процессора — сначала процессор."
	if k == "ram" and grade >= 8:
		# двухканальный режим: планки в слоты 2 и 4 (через один)
		if mount == "dimm1" or mount == "dimm3":
			return "Для двухканального режима планки ставят через один — в слоты 2 и 4 (они другого цвета)."
	if k == "ram":
		for p in have:
			if have[p] == mount:
				return "Этот слот уже занят — выбери другой."
	return ""

