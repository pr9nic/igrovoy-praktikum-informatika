const BASE := 20

static func cost(c: Dictionary) -> int:
	return BASE + int(OPTS["cpu"][c["cpu"]][1]) + int(OPTS["ram"][c["ram"]][1]) + int(OPTS["disk"][c["disk"]][1]) + int(OPTS["gpu"][c["gpu"]][1])

static func cfg_why(t: Dictionary, c: Dictionary) -> Array:
	var why := []
	if int(OPTS["ram"][c["ram"]][2]) < int(t["ram"]):
		why.append("памяти меньше %d Гбайт" % int(t["ram"]))
	if t["ssd"] and not OPTS["disk"][c["disk"]][3]:
		why.append("нужен SSD")
	if int(OPTS["disk"][c["disk"]][2]) < int(t["disk"]):
		why.append("мало места на диске")
	if int(OPTS["gpu"][c["gpu"]][2]) < int(t["gpu"]):
		why.append("слабая видеокарта")
	if int(OPTS["cpu"][c["cpu"]][2]) < int(t["cpu"]):
		why.append("слабый процессор")
	if cost(c) > int(t["budget"]):
		why.append("дороже бюджета (%d тыс.)" % cost(c))
	return why

static func cheapest(t: Dictionary) -> Dictionary:
	var best := {}
	for a in 3:
		for b in 4:
			for d in 4:
				for g in 3:
					var c := {"cpu": a, "ram": b, "disk": d, "gpu": g}
					if cfg_why(t, c).is_empty() and (best.is_empty() or cost(c) < cost(best)):
						best = c
	return best

