static func port_ok(cable: String, point: String) -> String:
	if cable == point:
		return ""
	if cable == "hdmi_gpu" and point == "hdmi_mb":
		return "Видеокарта установлена — HDMI на плате выдаёт только встроенную графику. Подключи монитор к видеокарте!"
	if CABLES.has(cable):
		return "Не тот разъём. %s" % CABLES[cable][1]
	return "Не тот разъём. %s" % PORTS[cable][1]

